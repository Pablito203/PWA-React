# Copie para .env.local (ignorado pelo git) e preencha.

# URL da API de push de homologação (output UrlApi do stack) e o AUTH_TOKEN da push-auth.
PUSH_API_URL=
PUSH_AUTH_TOKEN=
PUSH_AMBIENTE=OP

# API do repo RegistroAprovacoes, chamada pelos botões Aprovar/Reprovar da notificação.
APROVACAO_API_URL=http://localhost:3000/aprovacoes

# Config do app Web no Firebase (Configurações do projeto > Seus apps).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opcional: chave pública VAPID (Firebase > Cloud Messaging > Certificados Web Push).
# Sem ela o SDK usa a chave padrão do Firebase.
VITE_FCM_VAPID_KEY=
